{"root":{"data":{"id":"dhgzumixb5c0","created":1774962941542,"text":"包覆实验样品（学校留样）","priority":null},"children":[{"data":{"id":"dhgzvcb4fww0","created":1774962997667,"text":"(1) YSCZNZC（预烧除杂楠竹碳）包覆量","note":"这批竹原料应该是没去皮的竹子","layout":null},"children":[{"data":{"id":"dhgzvk1mk8w0","created":1774963014507,"text":"0","layout":null},"children":[]},{"data":{"id":"dhgzvm71e6o0","created":1774963019187,"text":"5%","layout":null},"children":[]},{"data":{"id":"dhgzvn6vvu00","created":1774963021355,"text":"10%","layout":null},"children":[]},{"data":{"id":"dhgzvokhwww0","created":1774963024355,"text":"15%","layout":null},"children":[]},{"data":{"id":"dhgzvpobu200","created":1774963026763,"text":"20%","layout":null},"children":[]}]},{"data":{"id":"dhgzz50mhc80","created":1774963295251,"text":"(2)炭化温度","note":"粗沥青炭化","layout":null},"children":[{"data":{"id":"dhh00sxnucg0","created":1774963425679,"text":"1400","layout":null},"children":[]},{"data":{"id":"dhh00u3xl2g0","created":1774963428235,"text":"1411","layout":null},"children":[]},{"data":{"id":"dhh00uak0j40","created":1774963428635,"text":"1461","layout":null},"children":[]},{"data":{"id":"dhh00uhp8mo0","created":1774963429067,"text":"1600（1511）?","layout":null},"children":[]}]},{"data":{"id":"dhgzwg7ax4g0","created":1774963084507,"text":"（3）升温速率","note":"包覆量+10% 1500℃","layout":null},"children":[{"data":{"id":"dhgzym518mw0","created":1774963254159,"text":"1℃/min","layout":null},"children":[]},{"data":{"id":"dhgzyna4yxs0","created":1774963256644,"text":"3℃/min","layout":null},"children":[]},{"data":{"id":"dhgzynjdghk0","created":1774963257203,"text":"5℃/min","layout":null},"children":[]},{"data":{"id":"dhgzynrkrs00","created":1774963257699,"text":"7℃/min","layout":null},"children":[]},{"data":{"id":"dhgzynybrhk0","created":1774963258107,"text":"10℃/min","layout":null},"children":[]}]},{"data":{"id":"dhh02pmj6yg0","created":1774963575204,"text":"（4）保温时间","note":"粗沥青10% 1500℃","layout":null},"children":[{"data":{"id":"dhh03n45odc